{
  "manifest_version": 3,
  "name": "TCGplayer Direct Munbyn Print",
  "version": "1.0.0",
  "description": "Print the native packing slip and matched address label directly on your local Munbyn printer.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://sellerportal.tcgplayer.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sellerportal.tcgplayer.com/*"
      ],
      "js": [
        "pdf-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://sellerportal.tcgplayer.com/*"
      ],
      "js": [
        "build-state.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TCGplayer print helper",
    "default_popup": "popup.html"
  }
}